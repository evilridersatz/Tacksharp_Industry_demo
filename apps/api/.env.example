# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- Database (MySQL 8 / MariaDB 10.6+) and Redis ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tacksharp
DB_PASSWORD=
DB_NAME=tacksharp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_TLS=false

# --- API ---
PORT=3000
# Public https URL of this API (Plivo and Meta must reach it). Local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# 32+ random characters in production
AUTH_SECRET=
NODE_ENV=development

# --- AI model (optional: ordering works without one) ---
# Local llama.cpp / Qwen:
#   OPENAI_BASE_URL=http://127.0.0.1:8080/v1
#   OPENAI_MODEL=Qwen3-1.7B-Q4_K_M
#   OPENAI_REASONING_EFFORT=off
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Marketing campaigns: your WhatsApp Business Account id (Meta Business Manager → WhatsApp accounts). Used only to
# READ your approved message templates for the campaign editor. Empty = campaigns can be drafted and simulated only.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=ta
# Approved "order ready" template, {{1}} = order number (used outside the 24h window)
WHATSAPP_TEMPLATE_ORDER_READY=
# Approved template for first contact / follow-ups (empty until Meta approves it)
WHATSAPP_TEMPLATE_NAME=
# How many {{n}} variables the template body has: 1 = name, 2 = name + requirement
WHATSAPP_TEMPLATE_PARAMS=2
# Optional: one approved template PER follow-up step (all take the same {{1}} name, {{2}} requirement).
# A step with no template of its own falls back to WHATSAPP_TEMPLATE_NAME.
WHATSAPP_TEMPLATE_FIRST_CONTACT=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_FINAL=
WHATSAPP_TEMPLATE_MISSED_CALL=
# Site-visit messages when the customer has not messaged in 24 h: {{1}} name, {{2}} "Property, Sat 10 Oct, 11:00 AM"
WHATSAPP_TEMPLATE_VISIT_CONFIRM=
WHATSAPP_TEMPLATE_VISIT_REMINDER=
WHATSAPP_TEMPLATE_VISIT_AFTER=
# Textile (industry = textile), optional, outside the 24h window: {{1}} customer name, {{2}} message text
WHATSAPP_TEMPLATE_TEXTILE_QUOTE=
WHATSAPP_TEMPLATE_TEXTILE_ORDER=
WHATSAPP_TEMPLATE_TEXTILE_FEEDBACK=
WHATSAPP_TEMPLATE_TEXTILE_INVOICE=
WHATSAPP_TEMPLATE_TEXTILE_PAYMENT=

# --- Meta Lead Ads ------------------------------------------
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_LEAD_VERIFY_TOKEN=choose-any-secret-string
# Your Facebook Page id. Lead-ad webhooks carry it; it decides which business a lead belongs to.
# Several businesses on one server: leave empty and add one OrganizationChannel row per page instead
# (see PRODUCTION_SETUP.md, "Which business does a webhook belong to?").
META_PAGE_ID=

# --- Order-ready call (Plivo + Sarvam Tamil voice) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_VALIDATE_SIGNATURE=false
SARVAM_API_KEY=
VOICE_CALL_WINDOW_START=9
VOICE_CALL_WINDOW_END=21

# --- GR Chicken seed (npm run seed:gr-chicken) ---
GR_ADMIN_EMAIL=
GR_ADMIN_PASSWORD=
GR_WHATSAPP_PHONE_NUMBER_ID=
# Number customers message, digits with country code, e.g. 919876543210 (for the wa.me claim link)
GR_WHATSAPP_DISPLAY_NUMBER=
GR_OFFER_TEMPLATE_NAME=
GR_OFFER_AMOUNT=50
