# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- Database (MySQL 8 / MariaDB 10.6+) and Redis ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tacksharp
DB_PASSWORD=
DB_NAME=tacksharp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_TLS=false

# --- API ---
PORT=3000
# Public https URL of this API (Plivo and Meta must reach it). Local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# 32+ random characters in production
AUTH_SECRET=
NODE_ENV=development

# --- AI model (optional: ordering works without one) ---
# Local llama.cpp / Qwen:
#   OPENAI_BASE_URL=http://127.0.0.1:8080/v1
#   OPENAI_MODEL=Qwen3-1.7B-Q4_K_M
#   OPENAI_REASONING_EFFORT=off
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Marketing campaigns: your WhatsApp Business Account id (Meta Business Manager → WhatsApp accounts). Used only to
# READ your approved message templates for the campaign editor. Empty = campaigns can be drafted and simulated only.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=ta
# Approved "order ready" template, {{1}} = order number (used outside the 24h window)
WHATSAPP_TEMPLATE_ORDER_READY=
# Approved template for first contact / follow-ups (empty until Meta approves it)
WHATSAPP_TEMPLATE_NAME=
# How many {{n}} variables the template body has: 1 = name, 2 = name + requirement
WHATSAPP_TEMPLATE_PARAMS=2
# Optional: one approved template PER follow-up step (all take the same {{1}} name, {{2}} requirement).
# A step with no template of its own falls back to WHATSAPP_TEMPLATE_NAME.
WHATSAPP_TEMPLATE_FIRST_CONTACT=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_FINAL=
WHATSAPP_TEMPLATE_MISSED_CALL=
# Site-visit messages when the customer has not messaged in 24 h: {{1}} name, {{2}} "Property, Sat 10 Oct, 11:00 AM"
WHATSAPP_TEMPLATE_VISIT_CONFIRM=
WHATSAPP_TEMPLATE_VISIT_REMINDER=
WHATSAPP_TEMPLATE_VISIT_AFTER=
# Textile (industry = textile), optional, outside the 24h window: {{1}} customer name, {{2}} message text
WHATSAPP_TEMPLATE_TEXTILE_QUOTE=
WHATSAPP_TEMPLATE_TEXTILE_ORDER=
WHATSAPP_TEMPLATE_TEXTILE_FEEDBACK=
WHATSAPP_TEMPLATE_TEXTILE_INVOICE=
WHATSAPP_TEMPLATE_TEXTILE_PAYMENT=

# --- Meta Lead Ads ------------------------------------------
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_LEAD_VERIFY_TOKEN=choose-any-secret-string
# Your Facebook Page id. Lead-ad webhooks carry it; it decides which business a lead belongs to.
# Several businesses on one server: leave empty and add one OrganizationChannel row per page instead
# (see PRODUCTION_SETUP.md, "Which business does a webhook belong to?").
META_PAGE_ID=

# --- Order-ready call (Plivo + Sarvam Tamil voice) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_VALIDATE_SIGNATURE=false
SARVAM_API_KEY=
VOICE_CALL_WINDOW_START=9
VOICE_CALL_WINDOW_END=21

# --- GR Chicken seed (npm run seed:gr-chicken) ---
GR_ADMIN_EMAIL=
GR_ADMIN_PASSWORD=
GR_WHATSAPP_PHONE_NUMBER_ID=
# Number customers message, digits with country code, e.g. 919876543210 (for the wa.me claim link)
GR_WHATSAPP_DISPLAY_NUMBER=
GR_OFFER_TEMPLATE_NAME=
GR_OFFER_AMOUNT=50

# --- Enterprise platform (self-service signup, per-organization provider credentials) ---
# Encryption keys for organizations' own provider credentials (never stored in the database). 32 random bytes each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new key, make it active, restart, run `npm run credentials:rotate`, then remove the old key.
CREDENTIALS_KEYS=
CREDENTIALS_ACTIVE_KEY=
# Public self-service registration (false closes /auth/signup; new organizations wait for platform activation).
SIGNUP_ENABLED=true
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_PROVIDER_TESTS=20
PROVIDER_TEST_TIMEOUT_MS=12000
# Optional prices for usage cost ESTIMATES (left empty = no estimate shown; the provider invoice is authoritative).
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
SARVAM_TTS_PRICE_PER_10K_CHARS=
SARVAM_STT_PRICE_PER_HOUR=

# --- Tara, the website / dashboard assistant (uses OPENAI_API_KEY and SARVAM_API_KEY above; never messages anyone) ---
OPENAI_ASSISTANT_MODEL=
OPENAI_ASSISTANT_REASONING_EFFORT=
ASSISTANT_TTS_SPEAKER=
ASSISTANT_TTS_PACE=1.05
RATE_LIMIT_ASSISTANT_PER_MIN=40
# Talking video presenter for Tara (Simli; stock presenter face). Both needed; video is billed per minute.
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_MAX_SESSION_SECONDS=600
SIMLI_MAX_IDLE_SECONDS=90
RATE_LIMIT_ASSISTANT_VIDEO_PER_10MIN=4

# --- Custom voice agents, knowledge bases and telephony routing (see VOICE-AGENTS.md) ---
# Uploaded knowledge-base files (per organization sub-folders, mode 700). Back this folder up with the database.
KNOWLEDGE_DIR=./data/knowledge
KB_MAX_FILE_MB=10
KB_MAX_DOCS=50
# Agent replies (dashboard test, public demos, calls handled by custom agents). Defaults to OPENAI_MODEL.
OPENAI_AGENT_MODEL=
OPENAI_AGENT_REASONING_EFFORT=
AGENT_MODEL_TIMEOUT_MS=15000
# HMAC secret (>= 32 random characters) for Sarvam result webhooks: Sarvam does not sign webhooks, so our webhook
# URLs carry a token. Without it, calls through Sarvam are refused (fail closed). Rotate = old webhook URLs stop working.
TELEPHONY_WEBHOOK_SECRET=
# Org-wide outbound caps (each agent's own limits can only be lower).
TELEPHONY_ORG_MAX_CONCURRENT=5
TELEPHONY_ORG_DAILY_LIMIT=200
# Platform Sarvam Voice Agents account for pre-existing organizations (others save their own in Settings → Integrations).
SARVAM_AGENTS_API_KEY=
SARVAM_AGENTS_ORG_ID=
SARVAM_AGENTS_WORKSPACE_ID=
SARVAM_AGENTS_CONNECTION_ID=
SARVAM_AGENTS_PHONE_NUMBER=
