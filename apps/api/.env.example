# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- Database (MySQL 8 / MariaDB 10.6+) and Redis ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tacksharp
DB_PASSWORD=
DB_NAME=tacksharp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_TLS=false

# --- API ---
PORT=3000
# Public https URL of this API (Plivo and Meta must reach it). Local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# 32+ random characters in production
AUTH_SECRET=
NODE_ENV=development

# --- AI model (optional: ordering works without one) ---
# Local llama.cpp / Qwen:
#   OPENAI_BASE_URL=http://127.0.0.1:8080/v1
#   OPENAI_MODEL=Qwen3-1.7B-Q4_K_M
#   OPENAI_REASONING_EFFORT=off
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=ta
# Approved "order ready" template, {{1}} = order number (used outside the 24h window)
WHATSAPP_TEMPLATE_ORDER_READY=

# --- Order-ready call (Plivo + Sarvam Tamil voice) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_VALIDATE_SIGNATURE=false
SARVAM_API_KEY=
VOICE_CALL_WINDOW_START=9
VOICE_CALL_WINDOW_END=21

# --- GR Chicken seed (npm run seed:gr-chicken) ---
GR_ADMIN_EMAIL=
GR_ADMIN_PASSWORD=
GR_WHATSAPP_PHONE_NUMBER_ID=
# Number customers message, digits with country code, e.g. 919876543210 (for the wa.me claim link)
GR_WHATSAPP_DISPLAY_NUMBER=
GR_OFFER_TEMPLATE_NAME=
GR_OFFER_AMOUNT=50
