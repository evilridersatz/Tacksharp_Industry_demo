generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id           String         @id @default(cuid())
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  calls        Call[]
  customers    Customer[]
  users        User[]
  Conversation Conversation[]
  followUps    FollowUp[]
  leads        Lead[]
  Message      Message[]
  properties   Property[]
  SiteVisit    SiteVisit[]
  channels     OrganizationChannel[]
  settings     OrganizationSettings?
}

/// Which organization owns an inbound identifier (WhatsApp phone_number_id, the Plivo number a customer dialed,
/// a Meta page id). Webhooks resolve the organization from here; an unknown identifier is rejected, never
/// silently assigned to a default organization.
model OrganizationChannel {
  id             String       @id @default(cuid())
  organizationId String
  /// whatsapp_phone_number_id | plivo_number | meta_page_id
  kind           String
  externalId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([kind, externalId])
  @@index([organizationId])
}

/// Per-business automation settings edited in the dashboard (cadence, reminders, team alerts, ROI inputs).
/// One JSON document; the application fills in defaults for anything missing.
model OrganizationSettings {
  organizationId String       @id
  data           Json
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  location       String
  type           String
  bhk            Int
  price          Decimal      @db.Decimal(15, 2)
  status         String       @default("available")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, location])
  @@index([organizationId, bhk])
  @@index([organizationId, status])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String?
  phone          String?
  email          String?
  language       String?
  source         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  location       String?
  budget         Decimal?       @db.Decimal(15, 2)
  bhk            Int?
  propertyType   String?
  /// Free-text facts the AI saved: timeline, objections, liked property, callback notes.
  purchaseTimeline     String?
  objections           String?   @db.Text
  interestedPropertyId String?
  callbackAt           DateTime?
  /// Set when the customer says not interested / wrong number. Blocks all automation.
  doNotContact         Boolean   @default(false)
  lastInboundAt        DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls          Call[]
  Conversation   Conversation[]
  followUps      FollowUp[]
  leads          Lead[]
  SiteVisit      SiteVisit[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, email])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  status         String       @default("new")
  budget         Decimal?     @db.Decimal(15, 2)
  location       String?
  bhk            Int?
  propertyType   String?
  source         String?
  /// Campaign / form name from the lead source.
  campaign       String?
  /// External source id (e.g. Meta leadgen_id) used to drop duplicate webhooks.
  externalRef    String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  calls          Call[]
  followUps      FollowUp[]
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@unique([organizationId, externalRef])
  @@index([customerId], map: "Lead_customerId_fkey")
}

model FollowUp {
  id                 String       @id @default(cuid())
  organizationId     String
  leadId             String
  customerId         String
  channel            String       @default("whatsapp")
  action             String       @default("message")
  message            String?      @db.Text
  scheduledAt        DateTime
  status             String       @default("scheduled")
  attempts           Int          @default(0)
  cancellationReason String?
  /// sequence = automatic lead sequence, callback = customer-requested, retry = call retry, task = human task
  source             String       @default("sequence")
  lastError          String?      @db.Text
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead               Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([customerId])
}

model Conversation {
  id             String       @id
  organizationId String
  customerId     String?
  channel        String
  externalId     String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer?    @relation(fields: [customerId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Message        Message[]

  @@unique([organizationId, channel, externalId])
  @@index([customerId], map: "Conversation_customerId_fkey")
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId])
}

model Message {
  id             String       @id
  organizationId String
  conversationId String
  role           String
  content        String       @db.Text
  externalId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, conversationId])
  @@index([organizationId])
}

model SiteVisit {
  id             String       @id
  organizationId String
  leadId         String
  customerId     String
  propertyId     String
  scheduledAt    DateTime
  status         String       @default("scheduled")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([leadId])
  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([propertyId])
}

/// One phone call (outbound or inbound) handled by the AI voice agent.
model Call {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String?
  customerId     String
  direction      String       @default("outbound")
  /// queued | ringing | in_progress | completed | no_answer | busy | failed
  status         String       @default("queued")
  /// connected | no_answer | busy | failed | interested | not_interested | callback_requested |
  /// human_requested | qualified | site_visit_requested | site_visit_booked | wrong_number | invalid_number
  outcome        String?
  toNumber       String
  fromNumber     String
  providerCallId String?
  providerRequestId String?
  attempt        Int          @default(1)
  turns          Int          @default(0)
  silentTurns    Int          @default(0)
  language       String?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  hangupCause    String?
  followUpId     String?
  summary        String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([leadId])
  @@index([providerCallId])
}

/// Dashboard user. organizationId on every request comes from here, never from the browser.
model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String
  role           String       @default("admin")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
