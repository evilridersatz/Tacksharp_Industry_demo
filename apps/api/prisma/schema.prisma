generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id           String         @id @default(cuid())
  name         String
  /// real_estate | restaurant. Decides which conversation engine and dashboard the tenant gets.
  vertical     String         @default("real_estate")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  calls        Call[]
  customers    Customer[]
  users        User[]
  Conversation Conversation[]
  followUps    FollowUp[]
  leads        Lead[]
  Message      Message[]
  properties   Property[]
  SiteVisit    SiteVisit[]
  channels     OrganizationChannel[]
  settings     OrganizationSettings?
  outlets        Outlet[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  orderEvents    OrderEvent[]
}

/// Which organization owns an inbound identifier (WhatsApp phone_number_id, the Plivo number a customer dialed,
/// a Meta page id). Webhooks resolve the organization from here; an unknown identifier is rejected, never
/// silently assigned to a default organization.
model OrganizationChannel {
  id             String       @id @default(cuid())
  organizationId String
  /// whatsapp_phone_number_id | plivo_number | meta_page_id
  kind           String
  externalId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([kind, externalId])
  @@index([organizationId])
}

/// Per-business automation settings edited in the dashboard (cadence, reminders, team alerts, ROI inputs).
/// One JSON document; the application fills in defaults for anything missing.
model OrganizationSettings {
  organizationId String       @id
  data           Json
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  location       String
  type           String
  bhk            Int
  price          Decimal      @db.Decimal(15, 2)
  status         String       @default("available")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, location])
  @@index([organizationId, bhk])
  @@index([organizationId, status])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String?
  phone          String?
  email          String?
  language       String?
  source         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  location       String?
  budget         Decimal?       @db.Decimal(15, 2)
  bhk            Int?
  propertyType   String?
  /// Free-text facts the AI saved: timeline, objections, liked property, callback notes.
  purchaseTimeline     String?
  objections           String?   @db.Text
  interestedPropertyId String?
  callbackAt           DateTime?
  /// Set when the customer says not interested / wrong number. Blocks all automation.
  doNotContact         Boolean   @default(false)
  lastInboundAt        DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls          Call[]
  Conversation   Conversation[]
  followUps      FollowUp[]
  leads          Lead[]
  SiteVisit      SiteVisit[]
  orders         Order[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, email])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  status         String       @default("new")
  budget         Decimal?     @db.Decimal(15, 2)
  location       String?
  bhk            Int?
  propertyType   String?
  source         String?
  /// Campaign / form name from the lead source.
  campaign       String?
  /// External source id (e.g. Meta leadgen_id) used to drop duplicate webhooks.
  externalRef    String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  calls          Call[]
  followUps      FollowUp[]
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@unique([organizationId, externalRef])
  @@index([customerId], map: "Lead_customerId_fkey")
}

model FollowUp {
  id                 String       @id @default(cuid())
  organizationId     String
  leadId             String
  customerId         String
  channel            String       @default("whatsapp")
  action             String       @default("message")
  message            String?      @db.Text
  scheduledAt        DateTime
  status             String       @default("scheduled")
  attempts           Int          @default(0)
  cancellationReason String?
  /// sequence = automatic lead sequence, callback = customer-requested, retry = call retry, task = human task
  source             String       @default("sequence")
  lastError          String?      @db.Text
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead               Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([customerId])
}

model Conversation {
  id             String       @id
  organizationId String
  customerId     String?
  channel        String
  externalId     String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer?    @relation(fields: [customerId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Message        Message[]

  @@unique([organizationId, channel, externalId])
  @@index([customerId], map: "Conversation_customerId_fkey")
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId])
}

model Message {
  id             String       @id
  organizationId String
  conversationId String
  role           String
  content        String       @db.Text
  externalId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, conversationId])
  @@index([organizationId])
}

model SiteVisit {
  id             String       @id
  organizationId String
  leadId         String
  customerId     String
  propertyId     String
  scheduledAt    DateTime
  status         String       @default("scheduled")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([leadId])
  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([propertyId])
}

/// One phone call (outbound or inbound) handled by the AI voice agent.
model Call {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String?
  customerId     String
  direction      String       @default("outbound")
  /// queued | ringing | in_progress | completed | no_answer | busy | failed
  status         String       @default("queued")
  /// connected | no_answer | busy | failed | interested | not_interested | callback_requested |
  /// human_requested | qualified | site_visit_requested | site_visit_booked | wrong_number | invalid_number
  outcome        String?
  toNumber       String
  fromNumber     String
  providerCallId String?
  providerRequestId String?
  attempt        Int          @default(1)
  turns          Int          @default(0)
  silentTurns    Int          @default(0)
  language       String?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  hangupCause    String?
  followUpId     String?
  summary        String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([leadId])
  @@index([providerCallId])
}

/// Dashboard user. organizationId on every request comes from here, never from the browser.
model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String
  role           String       @default("admin")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------------------------
// Restaurant vertical (GR Chicken). Prices, availability and totals live here and are only ever
// computed by the server; the language model never sets them.
// ---------------------------------------------------------------------------------------------

/// A restaurant outlet that accepts orders.
model Outlet {
  id                 String       @id @default(cuid())
  organizationId     String
  name               String
  address            String       @db.Text
  area               String?
  phone              String?
  /// Areas (lower-case names) this outlet delivers to. Empty = pickup only.
  serviceAreas       Json
  /// IST "HH:mm".
  opensAt            String       @default("11:00")
  closesAt           String       @default("23:00")
  acceptsPickup      Boolean      @default(true)
  acceptsDelivery    Boolean      @default(false)
  deliveryFee        Decimal      @default(0) @db.Decimal(10, 2)
  minOrderValue      Decimal      @default(0) @db.Decimal(10, 2)
  /// Accept orders outside opening hours (for testing a demo tenant). Staff still confirm every order.
  acceptOutsideHours Boolean      @default(false)
  active             Boolean      @default(true)
  /// True for placeholder data that has NOT been verified with the client.
  isDemo             Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@index([organizationId])
}

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  description    String?      @db.Text
  price          Decimal      @db.Decimal(10, 2)
  isVeg          Boolean      @default(false)
  available      Boolean      @default(true)
  imageUrl       String?      @db.Text
  /// Comma-separated other names customers use ("65, chicken sixty five").
  aliases        String?      @db.Text
  isDemo         Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([categoryId])
}

/// A customer order. Created only after the customer explicitly confirmed the server-computed total.
model Order {
  id              String       @id @default(cuid())
  organizationId  String
  /// Short reference shown to the customer and staff, e.g. GR-7K2Q9X.
  orderNumber     String
  customerId      String
  conversationId  String?
  outletId        String
  channel         String
  /// pickup | delivery
  fulfilment      String
  deliveryAddress String?      @db.Text
  deliveryArea    String?
  /// pending | confirmed | preparing | ready | out_for_delivery | completed | cancelled
  status          String       @default("pending")
  subtotal        Decimal      @db.Decimal(10, 2)
  deliveryFee     Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  /// cash_on_delivery | pay_at_outlet. No online payment is integrated.
  paymentMethod   String
  /// unpaid | paid. Only staff can mark an order paid.
  paymentStatus   String       @default("unpaid")
  /// not_integrated = the order lives only in Tacksharp; staff enter it into the outlet's POS.
  posStatus       String       @default("not_integrated")
  /// Same confirmation retried (webhook retry, double tap) -> the same order, never a second one.
  idempotencyKey  String
  customerName    String?
  customerPhone   String?
  notes           String?      @db.Text
  isDemo          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  outlet          Outlet       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  events          OrderEvent[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([outletId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  /// Name and price as charged (snapshot), so later menu edits never change a placed order.
  name       String
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  lineTotal  Decimal  @db.Decimal(10, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
}

/// Audit trail: order created, status changes, payment changes, who did it.
model OrderEvent {
  id             String       @id @default(cuid())
  organizationId String
  orderId        String
  /// created | status_changed | payment_changed | note
  type           String
  fromStatus     String?
  toStatus       String?
  /// "ai" | "system" | "user:<id>"
  actor          String
  note           String?      @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([organizationId, createdAt])
}
